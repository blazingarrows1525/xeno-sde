# Copy to .env.local for local dev, or set these in the Vercel dashboard.

# Backend API. When set, lib/api.ts points at the live CRM backend; otherwise the
# UI runs on mock data (the Agent Console shows "demo data" instead of "live · AI").
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public base URL of THIS web app — used to build OAuth callback URLs.
# Optional locally (the request origin is used); set it in production.
# e.g. https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=

# Secret used to sign the session cookie (any long random string).
# A dev fallback is used if unset; set a real value in production.
AUTH_SECRET=

# OAuth providers — OPTIONAL. Fill a pair to light up that provider's button on the
# login page. With neither set, the login page still works via the one-tap demo entry.
# Register these callback URLs with each provider:
#   <base>/api/auth/callback/google
#   <base>/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
